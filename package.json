{
  "name": "cv-questionnaire",
  "version": "1.0.0",
  "description": "Typeform-style CV questionnaire with email submission",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:api": "npx playwright test tests/api.spec.js",
    "test:flow": "npx playwright test tests/questionnaire-flow.spec.js",
    "postinstall": "node -e \"try{require('fs').rmSync('node_modules/pdf-parse/test',{recursive:true,force:true})}catch(e){}\""
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.2",
    "natural": "^8.1.0",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "pdf-parse": "^1.1.1",
    "validator": "^13.15.26",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "nodemon": "^3.0.2"
  }
}
