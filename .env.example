# Email Configuration
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here
RECIPIENT_EMAIL=your.email@gmail.com

# Server Configuration
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cv-questionnaire?retryWrites=true&w=majority
# Required for npm run test*: a separate test DB so the suite never writes to prod.
# Database name MUST contain "test" — server refuses to start in NODE_ENV=test otherwise.
MONGODB_URI_TEST=mongodb+srv://username:password@cluster.mongodb.net/cv-questionnaire-test?retryWrites=true&w=majority

# Admin Dashboard
ADMIN_PASSWORD=your_secure_admin_password